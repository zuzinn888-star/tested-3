-- Background Task Loop for Combat & Farming
task.spawn(function()
    while task.wait(0.1) do
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")

        if root then
            -- Auto Farm Coins
            if state.autoFarm then
                pcall(function()
                    local containers = {"Normal", "CoinContainer"}
                    for _, cName in pairs(containers) do
                        local cont = Workspace:FindFirstChild(cName)
                        if cont then
                            for _, coin in pairs(cont:GetChildren()) do
                                if coin:IsA("BasePart") and coin.Name:match("Coin") and coin.Transparency < 1 then
                                    root.CFrame = coin.CFrame
                                    task.wait(state.autoFarmSpeed / 10)
                                    break -- one coin per loop to avoid extreme kicks
                                end
                            end
                        end
                    end
                end)
            end

            -- Auto Pickup Gun
            if state.autoPickupGun then
                pcall(function()
                    local gunDrop = Workspace:FindFirstChild("GunDrop", true)
                    if gunDrop and gunDrop:IsA("BasePart") then
                        root.CFrame = gunDrop.CFrame
                    end
                end)
            end

            -- Auto Fling Sheriff
            if state.autoFlingSheriff then
                pcall(function()
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and getRole(p) == "Sheriff" and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            root.CFrame = p.Character.HumanoidRootPart.CFrame
                            local bv = Instance.new("BodyVelocity")
                            bv.Velocity = Vector3.new(10000, 10000, 10000)
                            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bv.Parent = root
                            task.wait(0.1)
                            bv:Destroy()
                        end
                    end
                end)
            end

            -- Kill Aura / Kill All
            if state.killAura or state.killAll then
                pcall(function()
                    local knife = char:FindFirstChild("Knife") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Knife"))
                    if knife then
                        knife.Parent = char -- Equip
                        for _, p in pairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                                local targetRole = getRole(p)
                                local shouldKill = state.killAll or (state.killAura and (targetRole ~= "Murderer"))
                                if state.killOnlySheriff and targetRole ~= "Sheriff" then shouldKill = false end

                                if shouldKill then
                                    local dist = (p.Character.HumanoidRootPart.Position - root.Position).Magnitude
                                    if state.killAll and dist > 15 then
                                        -- Teleport to them if kill all is on
                                        root.CFrame = p.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
                                        task.wait(0.1)
                                    end
                                    if (p.Character.HumanoidRootPart.Position - root.Position).Magnitude <= 18 then
                                        knife:Activate()
                                    end
                                end
                            end
                        end
                    end
                end)
            end
            
            -- Silent Aim & Auto Shoot (Sheriff)
            if state.silentAim or state.autoShootMurder then
                pcall(function()
                    local gun = char:FindFirstChild("Gun") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Gun"))
                    if gun then
                        for _, p in pairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer and getRole(p) == "Murderer" and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                                if state.autoShootMurder then
                                    gun.Parent = char
                                    -- ReplicatedStorage calls or direct CFrame manip depending on exploit.
